#define NMAX 20
typedef long long unsigned llu;
using namespace std;
llu Factorial(llu n){
    llu i, p = 1;
    for(i=2;i<=n; i++)
        p *= i;
        return p;
    }
llu FactorialRecursiv(llu n){
    if (n<=1)
        return 1;
        return FactorialRecursiv(n-1)*n;
    }
    llu Permutari(llu n){
        return Factorial(n);
    }
    llu Aranjamente(llu n, llu k){
        return Factorial(n)/Factorial(n-k);
    }
    llu AranjamenteOptim(llu n, llu k){
         llu i, p = 1;
    for(i=n-k+1;i<=n; i++)
        p *= i;
        return p;
    }
     llu Conbinari(llu n, llu k){
        return Factorial(n)/(Factorial(k)*Factorial(n-k));
    }
 llu ConbinariOptim(llu n, llu k){
         llu aux, i, p = 1 ,q=1;
         aux = (k>n-k)?k:(n-k);
    for(i=aux+1;i<=n; i++){
        p *= i;
        }
        for(i=2; i<=n-aux; i++){
        q *= i;
        }
        return p/q;
    }
    llu RPermutari(llu n){
        return pow(n,n);
    }
    llu RAranjamente(llu n, llu k){
        return pow(n,k);
    }
    llu RConbinari(llu n,llu k){
        return pow(n+k-1,k);
    }

llu Putere(llu baza, llu exp){
    llu i, p = 1;
    for(i=1; i<=exp; i++)
        p *= baza;
    return p;
}


void BinomNewton(llu a, llu b, llu n){
    llu k, coef, suma = 0;
    cout << "\n(" << a << "+" << b << ")^" << n << " = ";
    for(k=0; k<=n; k++){
        coef = ConbinariOptim(n, k);
        cout << coef << "*" << a << "^" << n-k << "*" << b << "^" << k;
        if(k<n) cout << " + ";
        suma += coef * Putere(a, n-k) * Putere(b, k);
    }
    cout << "\nSuma dezvoltarii = " << suma;
    cout << "\nVerificare (a+b)^n = " << Putere(a+b, n);
}

void PermutariCuvinte(char cuv[]){
    int frecv[256] = {0};
    int i, lung = strlen(cuv);
    llu rez, nr = 0;

    for(i=0; i<lung; i++)
        frecv[(unsigned char)cuv[i]]++;

    rez = Factorial(lung);
    for(i=0; i<256; i++)
        if(frecv[i] > 1)
            rez /= Factorial(frecv[i]);

    cout << "\nCuvantul \"" << cuv << "\" are " << lung << " litere";
    cout << "\nNumar de permutari distincte = " << rez;

    if(rez <= 120){
        cout << "\nPermutarile:\n";
        sort(cuv, cuv+lung);
        do{
            nr++;
            cout << setw(3) << nr << ". " << cuv << endl;
        } while(next_permutation(cuv, cuv+lung));
    }
    else cout << "\n(prea multe, nu le afisez)";
}

int x[NMAX+1];
int folosit[NMAX+1];
llu contor;

void Afisare(int m){
    int i;
    contor++;
    cout << setw(5) << contor << ". ";
    for(i=1; i<=m; i++)
        cout << x[i] << " ";
    cout << endl;
}

void GenPermutari(int p, int n){
    int v;
    if(p > n){
        Afisare(n);
        return;
    }
    for(v=1; v<=n; v++){
        if(!folosit[v]){
            x[p] = v;
            folosit[v] = 1;
            GenPermutari(p+1, n);
            folosit[v] = 0;
        }
    }
}

void GenAranjamente(int p, int n, int k){
    int v;
    if(p > k){
        Afisare(k);
        return;
    }
    for(v=1; v<=n; v++){
        if(!folosit[v]){
            x[p] = v;
            folosit[v] = 1;
            GenAranjamente(p+1, n, k);
            folosit[v] = 0;
        }
    }
}

void GenCombinari(int p, int n, int k){
    int v;
    if(p > k){
        Afisare(k);
        return;
    }
    for(v=x[p-1]+1; v<=n; v++){
        x[p] = v;
        GenCombinari(p+1, n, k);
    }
}

